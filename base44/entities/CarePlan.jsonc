{
  "name": "CarePlan",
  "type": "object",
  "properties": {
    "patient": {
      "type": "string",
      "description": "Patient id"
    },
    "pathway": {
      "type": "string",
      "enum": [
        "diabetes",
        "post_op",
        "maternal",
        "tb"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "steps": {
      "type": "string",
      "description": "Outline of the pathway steps"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "patient",
    "pathway"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        },
        {
          "user_condition": {
            "role": "lab"
          }
        },
        {
          "user_condition": {
            "role": "pharmacy"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    }
  }
}