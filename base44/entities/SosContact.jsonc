{
  "name": "SosContact",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Contact name"
    },
    "phone": {
      "type": "string",
      "description": "Phone number with country code"
    },
    "email": {
      "type": "string",
      "description": "Email address for alerts"
    },
    "relationship": {
      "type": "string",
      "description": "Relationship to the user (e.g. father, mother, spouse)"
    }
  },
  "required": [
    "name",
    "phone"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_id": "{user.id}"
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        },
        {
          "user_condition": {
            "role": "lab"
          }
        },
        {
          "user_condition": {
            "role": "pharmacy"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_id": "{user.id}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.created_by_id": "{user.id}"
        }
      ]
    }
  }
}