{
  "name": "Patient",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "dob": {
      "type": "string",
      "format": "date"
    },
    "phone": {
      "type": "string"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "en",
        "hi",
        "ta",
        "te",
        "bn"
      ],
      "default": "en"
    },
    "clinic": {
      "type": "string",
      "description": "Provider id of the patient's clinic"
    },
    "primary_clinician": {
      "type": "string"
    },
    "consent_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "missing"
      ],
      "default": "missing"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        },
        {
          "user_condition": {
            "role": "lab"
          }
        },
        {
          "user_condition": {
            "role": "pharmacy"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        }
      ]
    }
  }
}