{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "entity": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "actor",
    "action",
    "entity"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        },
        {
          "user_condition": {
            "role": "lab"
          }
        },
        {
          "user_condition": {
            "role": "pharmacy"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}