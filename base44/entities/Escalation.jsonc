{
  "name": "Escalation",
  "type": "object",
  "properties": {
    "task": {
      "type": "string",
      "description": "CareTask id"
    },
    "level": {
      "type": "string",
      "enum": [
        "1",
        "2",
        "3"
      ],
      "default": "1"
    },
    "reason": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "sla_breach_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "acknowledged",
        "resolved"
      ],
      "default": "open"
    },
    "handoff_note": {
      "type": "string"
    }
  },
  "required": [
    "task"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "coordinator"
          }
        },
        {
          "user_condition": {
            "role": "clinician"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}